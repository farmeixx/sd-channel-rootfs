#!/bin/sh
# Grow the SD card root partition and then the root filesystem.
# Runs on every boot; both operations are idempotent.

ROOT_DEV=$(awk '$2 == "/" { print $1; exit }' /proc/mounts)

case "$ROOT_DEV" in
    *mmcblk1p1*)
        echo "channel-grow-rootfs: booting from SD card: $ROOT_DEV"
        DISK=${ROOT_DEV%p1}
        parted -s "$DISK" resizepart 1 100%
        partprobe "$DISK" 2>/dev/null || mdev -s 2>/dev/null || true
        resize2fs "$ROOT_DEV"
        ;;
    *)
        echo "channel-grow-rootfs: not booting from SD card ($ROOT_DEV), nothing to do"
        ;;
esac
